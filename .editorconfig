# Editor settings: https://editorconfig.org. test_editorconfig.sh checks
# every file in git against them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,yml,yaml,json,cff,md}]
indent_size = 2

# make needs a tab before each recipe line.
[{Makefile.am,Makefile}]
indent_style = tab
indent_size = 8
