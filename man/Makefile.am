# The man pages. They are generated by make rather than by configure so that
# the install paths in them are fully expanded: configure would leave
# "${exec_prefix}" in. Hyphens in those paths, and in the version (a -dev
# one appears in an example), are written as \- so that
# they render as the ASCII character a reader can paste into a shell, and
# each / is followed by \: -- a place groff may break the line, invisible
# otherwise -- so that a long --prefix wraps instead of overflowing.

man1_MANS = blas-microbenchmark.1 bmb_report.1
CLEANFILES = $(man1_MANS)

# One alias page per benchmark, so that "man bmb_dgemm" opens the shared
# page. Written at install time: 32 one-line files are not worth
# keeping in the tree. test_man_content.sh checks this list against the
# benchmarks actually built.
# BEGIN routines (man-makefile): written by src/c/routines.sh
ROUTINES = sasum dasum scasum dzasum saxpy daxpy caxpy zaxpy scopy \
	dcopy ccopy zcopy sdot ddot cdotc zdotc cdotu zdotu snrm2 dnrm2 \
	scnrm2 dznrm2 sscal dscal cscal zscal sswap dswap cswap zswap isamax \
	idamax icamax izamax srot drot sgemv dgemv cgemv zgemv sger dger \
	cgeru zgeru cgerc zgerc ssymv dsymv chemv zhemv sspmv dspmv ssyr dsyr \
	cher zher ssyr2 dsyr2 cher2 zher2 strmv dtrmv ctrmv ztrmv strsv dtrsv \
	ctrsv ztrsv stpsv dtpsv sgemm dgemm cgemm zgemm ssymm dsymm csymm \
	zsymm chemm zhemm ssyrk dsyrk csyrk zsyrk cherk zherk ssyr2k dsyr2k \
	csyr2k zsyr2k cher2k zher2k strmm dtrmm ctrmm ztrmm strsm dtrsm ctrsm \
	ztrsm
# END routines (man-makefile)

SUBST = v=$$(printf '%s' '$(PACKAGE_VERSION)' | sed 's/-/\\\\-/g') && \
	d=$$(printf '%s' '$(pkglibexecdir)' | sed -e 's/-/\\\\-/g' -e 's|/|/\\\\:|g') && \
	s=$$(printf '%s' '$(pkgdatadir)' | sed -e 's/-/\\\\-/g' -e 's|/|/\\\\:|g') && \
	sed -e "s|@PACKAGE_VERSION[@]|$$v|g" \
	    -e "s|@pkglibexecdir[@]|$$d|g" \
	    -e "s|@pkgdatadir[@]|$$s|g"

blas-microbenchmark.1: $(srcdir)/blas-microbenchmark.1.in Makefile
	$(AM_V_GEN)$(SUBST) $(srcdir)/blas-microbenchmark.1.in >$@.tmp && mv -f $@.tmp $@

bmb_report.1: $(srcdir)/bmb_report.1.in Makefile
	$(AM_V_GEN)$(SUBST) $(srcdir)/bmb_report.1.in >$@.tmp && mv -f $@.tmp $@

install-data-hook:
	for r in $(ROUTINES); do \
	    echo '.so man1/blas-microbenchmark.1' >"$(DESTDIR)$(man1dir)/bmb_$$r.1" || exit 1; \
	done

uninstall-hook:
	for r in $(ROUTINES); do rm -f "$(DESTDIR)$(man1dir)/bmb_$$r.1"; done

# The documentation site: the man pages as HTML, an index, and a page of
# outputs made by running the benchmarks (so build them first), in html/.
# Built on demand by "make html" (Automake's own html target, extended
# through html-local), with mandoc; .github/workflows/pages.yml publishes
# it. Not installed: the installed documentation is the man pages.
html-local: $(man1_MANS)
	$(AM_V_GEN)srcdir='$(srcdir)' TOP='$(top_srcdir)' IMAGES='$(top_srcdir)/doc/images' BENCH_DIR=../src/c \
	    $(SHELL) $(srcdir)/html.sh html '$(PACKAGE_VERSION)' $(man1_MANS)

clean-local:
	rm -rf html

TESTS = test_man_render.sh test_man_options.sh test_man_content.sh test_man_install.sh \
	test_man_html.sh
AM_TESTS_ENVIRONMENT = \
	ROUTINES='$(ROUTINES)' MAKE='$(MAKE)' mandir='$(mandir)' \
	man1dir='$(man1dir)' pkglibexecdir='$(pkglibexecdir)' PACKAGE_VERSION='$(PACKAGE_VERSION)'; \
	export ROUTINES MAKE mandir man1dir pkglibexecdir PACKAGE_VERSION;

# The guides of the site (html.sh): its pages that are not man pages.
SITE_GUIDES = site/install.html site/first-run.html site/compare.html \
	site/backends.html site/hpc.html site/reframe.html

EXTRA_DIST = blas-microbenchmark.1.in bmb_report.1.in man_helper.sh html.sh devpage.sh site.css \
	$(SITE_GUIDES) $(TESTS)
